# Copy to config.env and adjust for one-time Kicksecure image build/import.

PROJECT_ID=project-135adecf-38fc-4e43-ae4
REGION=us-central1
ZONE=us-central1-a

# GCS staging for disk import (must exist; compute service account needs read access)
IMPORT_BUCKET=scraper-intl-deployments-239573
IMPORT_PREFIX=images/kicksecure-cli

# Kicksecure KVM CLI image (stable) — https://www.kicksecure.com/wiki/KVM
KICKSECURE_VERSION=18.1.4.2
KICKSECURE_URL=https://www.kicksecure.com/download/libvirt/${KICKSECURE_VERSION}/Kicksecure-CLI-${KICKSECURE_VERSION}.Intel_AMD64.qcow2.libvirt.xz

# Name for the custom GCP image
GCP_IMAGE_NAME=kicksecure-cli-18-1-4-2

# Working directory for download/extract/convert (needs ~15GB free)
WORK_DIR=${HOME}/kicksecure-gcp-import

# OS hint for gcloud compute images import (Kicksecure is Debian-based)
IMPORT_OS=debian-12
